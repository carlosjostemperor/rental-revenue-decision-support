
from pathlib import Path
import os
import sys
import subprocess

REPO = "https://github.com/carlosjostemperor/rental-revenue-decision-support.git"
PROJECT_ROOT = Path("/content/rental-revenue-decision-support")

# Automatically download or update the GitHub project.
if (PROJECT_ROOT / ".git").is_dir():
    subprocess.run(
        ["git", "-C", str(PROJECT_ROOT), "pull", "--ff-only"],
        check=True
    )
elif not PROJECT_ROOT.exists():
    subprocess.run(
        ["git", "clone", "--depth", "1", "--branch", "main",
         REPO, str(PROJECT_ROOT)],
        check=True
    )
else:
    raise RuntimeError("Project folder exists but is not a Git repository.")

os.chdir(PROJECT_ROOT)

if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

import pandas as pd
import matplotlib.pyplot as plt
from IPython.display import display

import rm_analytics
from rm_analytics import AnalysisConfig, run_analysis, export_run
from rm_analytics.charts import build_figures

pd.set_option("display.max_colwidth", 160)

print("GitHub synchronization successful!")
print("Project:", PROJECT_ROOT)
print("Version:", rm_analytics.__version__)
